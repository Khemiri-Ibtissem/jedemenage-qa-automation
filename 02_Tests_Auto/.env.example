# Modèle du fichier .env (facultatif : les valeurs ci-dessous sont celles par défaut)
# 1. Copier ce fichier et le renommer en .env
# 2. Changer seulement ce qui est différent sur ton PC

# Adresse de l'application lancée par Playwright (serveur PHP dédié aux tests)
BASE_URL=http://127.0.0.1:8010

# Comptes créés par database/seeders/DatabaseSeeder.php (base de test locale, pas de vrais comptes)
COMPTE_ADMIN_EMAIL=admin@jedemenage.com
COMPTE_MOVER_EMAIL=mover@jedemenage.com
COMPTE_CLIENT_EMAIL=client@jedemenage.com
COMPTE_MDP=password
